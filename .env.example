# Neon (Lakebase Postgres) connection string — pooled.
# Local: written to .env.local, which is gitignored.
# Production: set in the Vercel project's environment variables.
#
# The app runs fully without this: the hymnal is a static corpus and works
# offline. Only song suggestions and device sync need the database, and both
# degrade gracefully when DATABASE_URL is absent.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Resend API key, for emailing song suggestions as they arrive.
# Optional: without it, suggestions are still saved to the database and are
# readable with `node scripts/suggestions.mjs` — only the email is skipped.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional overrides. Recipient defaults to fallmichael60@gmail.com, and the
# sender to Resend's shared onboarding@resend.dev, which needs no DNS setup.
# SUGGESTIONS_EMAIL=someone@example.com
# SUGGESTIONS_FROM=Hymnal <hymnal@yourdomain.com>
